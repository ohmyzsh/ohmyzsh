#compdef artisan la4 la5

# Laravel autocompletion
# Author: John Hamelink <john@johnhamelink.com>
#
# This plugin does the following:
#  - Adds aliases and autocompletion for artisan
#  - Adds aliases and autocompletion for bob

local curcontext="$curcontext" state line _opts _bundles ret=1
local php_command command_list
local -a artisan_commands

# Laravel 4 and later expose the project's built-in and custom commands.
# Keep the legacy completion below for Laravel 3, which has no raw list.
zstyle -s ':omz:plugins:laravel' php php_command || php_command=php
if [[ -f artisan ]] && command_list=$(
    "${(@Q)${(z)php_command}}" artisan list --raw --no-ansi 2>/dev/null
); then
    artisan_commands=("${(@f)command_list}")
    artisan_commands=(${artisan_commands[@]%%[[:space:]]*})
fi

_arguments -C \
    '1: :->cmds' \
    '*:: :->args' && ret=0

case $state in
    cmds)

    if (( ${#artisan_commands} )); then
        compadd -- "${artisan_commands[@]}"
        return $?
    fi

    _values "Artisan command" \
        'session\:install[Create a session table]' \
        'migrate[Manage Migrations]' \
        'test[Run a test]' \
        'route\:\:call[Call a route in the CLI]' \
        'key\:\:generate[Generate a key]'
        ret=0
        ;;
    args)
        if (( ${#artisan_commands} )); then
            _files
            return $?
        fi
        case $line[1] in
            migrate)
                _values \
                    'install[Create the Laravel migration table' \
                    'make[Create a migration]' \
                    'rollback[Roll back to the last migration operation]' \
                    'reset[Roll back all migrations that have ever run]'
                ret=0
                ;;
        esac
        ;;
esac

return ret
