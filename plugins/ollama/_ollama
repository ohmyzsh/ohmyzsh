#compdef ollama

_ollama_add_model_matches() {
  # _wanted supplies a default group. Replace it so each table keeps its header
  # beside its own matches even when the user's group-name style is unset.
  local -a groups
  zparseopts -D -E -a groups J: V:
  compadd "$@" -V "$completion_tag" -l -d descriptions -a references
}

_ollama_describe_models() {
  # Records contain reference, bytes, size, default, updated, context,
  # capabilities, and cloud status.
  local completion_tag=$1 label=$2 candidate_array=$3 order entry reference
  local description size_key display heading updated context capabilities cloud
  local date_heading=Updated context_heading=Context
  local capability_heading=Capabilities
  local -i reference_width=5 size_width=4 updated_width=7 context_width=7
  local -i capabilities_width=12 show_size=1
  local -a candidates=("${(@P)candidate_array}")
  local -a references descriptions expl fields layout unknown group size_keys
  local -a defaults
  local -A size_groups
  shift 3
  zstyle -s ":completion:${curcontext}:$completion_tag" model-sort order
  case $order in
    alphabetical) candidates=("${(@o)candidates}") ;;
    reverse) candidates=("${(@On)candidates}") ;;
    source) ;;
    newest|popular)
      [[ $completion_tag == remote-models ]] || \
        candidates=("${(@on)candidates}")
      ;;
    latest-first)
      candidates=("${(@on)candidates}")
      group=()
      for entry in "$candidates[@]"; do
        fields=("${(@ps:\t:)entry}")
        if [[ $fields[4] == 1 ]]; then
          defaults+=("$entry")
        else
          group+=("$entry")
        fi
      done
      candidates=("$defaults[@]" "$group[@]")
      ;;
    size|reverse-size)
      for entry in "$candidates[@]"; do
        fields=("${(@ps:\t:)entry}")
        if [[ $fields[2] == <-> ]]; then
          size_groups[$fields[2]]+="$entry"$'\n'
        else
          unknown+=("$entry")
        fi
      done
      size_keys=("${(@onk)size_groups}")
      [[ $order == reverse-size ]] && size_keys=("${(@On)size_keys}")
      candidates=()
      for size_key in "$size_keys[@]"; do
        group=("${(@f)${size_groups[$size_key]%$'\n'}}")
        candidates+=("${(@on)group}")
      done
      candidates+=("${(@on)unknown}")
      ;;
    *) candidates=("${(@on)candidates}") ;;
  esac
  [[ $completion_tag == remote-models ]] && show_size=0
  [[ $completion_tag == (remote-models|model-tags) ]] && \
    capability_heading='Family capabilities'
  [[ $label == 'local model' ]] && date_heading=Modified
  [[ $label == 'running model' ]] && context_heading='Loaded context'
  updated_width=${#date_heading}
  context_width=${#context_heading}
  capabilities_width=${#capability_heading}
  for entry in "$candidates[@]"; do
    fields=("${(@ps:\t:)entry}")
    reference=${entry%%$'\t'*}
    (( ${#reference} > reference_width )) && reference_width=${#reference}
    (( ${#fields[3]} > size_width )) && size_width=${#fields[3]}
    (( ${#fields[5]} > updated_width )) && updated_width=${#fields[5]}
    (( ${#fields[6]} > context_width )) && context_width=${#fields[6]}
    (( ${#fields[7]} > capabilities_width )) && \
      capabilities_width=${#fields[7]}
  done
  for entry in "$candidates[@]"; do
    fields=("${(@ps:\t:)entry}")
    reference=$fields[1]
    references+=("$reference")
    description=${fields[3]:--}
    updated=${fields[5]:--}
    context=${fields[6]:--}
    capabilities=${fields[7]:--}
    cloud=${fields[8]:--}
    # Each column has the same width across this menu, including unknown values.
    printf -v display '%-*s -- ' $reference_width "$reference"
    if (( show_size )); then
      printf -v heading '%-*s  ' $size_width "$description"
      display+=$heading
    fi
    printf -v heading '%-*s  %-*s  %-*s  %-5s' \
      $updated_width "$updated" $context_width "$context" \
      $capabilities_width "$capabilities" "$cloud"
    display+=$heading
    if [[ $fields[4] == 1 ]]; then
      display+='  *latest (default)'
    fi
    if zstyle -T ":completion:${curcontext}:$completion_tag" verbose; then
      descriptions+=("$display")
    else
      descriptions+=("$reference")
    fi
  done
  # Add aligned descriptions directly: _describe groups identical descriptions,
  # which can move the latest variant and reorder an otherwise sorted menu.
  layout=(-l -V "$completion_tag")
  if zstyle -T ":completion:${curcontext}:$completion_tag" verbose; then
    printf -v heading '%-*s -- ' $reference_width Model
    if (( show_size )); then
      printf -v display '%-*s  ' $size_width Size
      heading+=$display
    fi
    printf -v display '%-*s  %-*s  %-*s  %-5s' \
      $updated_width "$date_heading" $context_width "$context_heading" \
      $capabilities_width "$capability_heading" Cloud
    label+=$'\n'"$heading$display"
    layout+=(-X "$label")
  fi
  # Continue public family selection in the same argument, at its tag boundary.
  [[ $completion_tag == remote-models ]] && layout+=(-S ':')
  _wanted -V "$completion_tag" expl "$label" _ollama_add_model_matches \
    "$@" "$layout[@]"
}

_ollama_describe_values() {
  local completion_tag=$1 label=$2 candidate_array=$3 entry reference display
  local -i width=0
  local -a candidates=("${(@P)candidate_array}") references descriptions expl
  shift 3
  for entry in "$candidates[@]"; do
    reference=${entry%%:*}
    (( ${#reference} > width )) && width=${#reference}
  done
  for entry in "$candidates[@]"; do
    reference=${entry%%:*}
    references+=("$reference")
    if zstyle -T ":completion:${curcontext}:$completion_tag" verbose; then
      printf -v display '%-*s -- %s' $width "$reference" "${entry#*:}"
      descriptions+=("$display")
    else
      descriptions+=("$reference")
    fi
  done
  _wanted "$completion_tag" expl "$label" compadd "$@" \
    -l -d descriptions -a references
}

_ollama_commands() {
  local -a commands=(
    'serve:Start Ollama' 'start:Start Ollama'
    'create:Create a model' 'show:Show information for a model'
    'run:Run a model' 'stop:Stop a running model'
    'pull:Pull a model from a registry' 'push:Push a model to a registry'
    'signin:Sign in to ollama.com' 'signout:Sign out from ollama.com'
    'list:List models' 'ls:List models' 'ps:List running models'
    'cp:Copy a model' 'rm:Remove models'
    'launch:Launch the Ollama menu or an integration' 'help:Show command help'
  )
  _ollama_describe_values commands 'ollama command' commands "$@"
}

_ollama_local_models() {
  (( $+commands[curl] && $+commands[jq] )) || return 1
  local endpoint=tags kind=local host=${OLLAMA_HOST:-127.0.0.1:11434}
  local output default_port=11434
  if [[ $1 == running ]]; then
    endpoint=ps
    kind=running
    shift
  fi
  # Match the CLI's default port and wildcard bind-address conventions.
  if [[ $host == *://* ]]; then
    [[ $host == https://* ]] && default_port=443 || default_port=80
  elif [[ $host == ollama.com ]]; then
    host=https://ollama.com
    default_port=443
  else
    host="http://$host"
  fi
  local scheme=${host%%://*} address=${${host#*://}%%/*} basepath=${host#*://}
  [[ $basepath == */* ]] && basepath="/${basepath#*/}" || basepath=''
  [[ $scheme == (http|https) ]] || return 1
  if [[ $address == \[*\]* ]]; then
    [[ $address == *\]:* ]] || address+=:$default_port
  elif [[ $address == *:*:* ]]; then
    address="[$address]:$default_port"
  elif [[ $address != *:* ]]; then
    address+=:$default_port
  fi
  case $address in
    :*) address="127.0.0.1$address" ;;
    0.0.0.0:*) address="127.0.0.1:${address##*:}" ;;
    \[::\]:*) address="[::1]:${address##*:}" ;;
  esac
  # Do not invoke `ollama list`: its heartbeat can start the macOS app.
  output=$(command curl -q -fsS --connect-timeout 1 --max-time 2 \
    --max-filesize 2097152 \
    "$scheme://$address${basepath%/}/api/$endpoint" 2>/dev/null) || return 1
  local -a models
  models=("${(@f)$(print -r -- "$output" | command jq -r \
    '.models[]? | select(.name | type == "string") |
     [.name,
      (if (.size | type) == "number" and .size >= 0
       then (.size | floor | tostring) else "" end), "", "0",
      (if (.modified_at | type) == "string" and
          (.modified_at | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T"))
       then .modified_at[0:10] else "" end),
      (if (.context_length | type) == "number" and .context_length > 0
       then (.context_length | floor | tostring) else "" end),
      ([.capabilities[]? | select(type == "string") |
        select(test("^(completion|tools|insert|vision|embedding|thinking|image|audio|decision)$"))]
       | unique | join(",")),
      (if ((.remote_host // "") != "" or (.remote_model // "") != "")
       then "yes" else "no" end)] | @tsv' \
    2>/dev/null)}")
  models=("${(@)models:#}")
  (( $#models )) || return 1
  local entry bytes display
  local -a fields records
  for entry in "$models[@]"; do
    fields=("${(@ps:\t:)entry}")
    bytes=$fields[2]
    display=''
    if [[ $bytes == <-> ]]; then
      if (( bytes >= 1000000000000 )); then
        printf -v display '%.1fTB' $(( bytes / 1000000000000.0 ))
      elif (( bytes >= 1000000000 )); then
        printf -v display '%.1fGB' $(( bytes / 1000000000.0 ))
      elif (( bytes >= 1000000 )); then
        printf -v display '%.1fMB' $(( bytes / 1000000.0 ))
      else
        display="${bytes}B"
      fi
    fi
    entry="$fields[1]"$'\t'"$bytes"$'\t'"$display"$'\t0\t'
    entry+="$fields[5]"$'\t'"$fields[6]"$'\t'"$fields[7]"$'\t'"$fields[8]"
    records+=("$entry")
  done
  models=("$records[@]")
  _ollama_describe_models models "$kind model" models "$@"
}

_ollama_running_models() {
  _ollama_local_models running "$@"
}

_ollama_catalogue() {
  local model=$1 names=$2 base endpoint key output parsed order
  local -a request
  reply=()
  (( $+commands[curl] )) || return 1
  zstyle -s ":completion:${curcontext}:" metadata-url base || \
    base=https://ollama-model-cache.amcox886.chatgpt.site
  [[ $base == http://* || $base == https://* ]] || return 1
  request=(--get --data-urlencode format=completion-tsv)
  if [[ -n $model ]]; then
    [[ $model =~ '^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)?$' ]] || return 1
    [[ $model != . && $model != .. && ${model##*/} != (.|..) ]] || return 1
    endpoint=tags
    request+=(--data-urlencode "model=$model")
  else
    endpoint=models
    zstyle -s ":completion:${curcontext}:remote-models" model-sort order
    [[ $order == (newest|popular) ]] && \
      request+=(--data-urlencode "sort=$order")
    [[ -n $names ]] && request+=(--data-urlencode "names=$names")
  fi
  key="${base%/}/api/v1/$endpoint|$model|$names|${request[(r)sort=*]}"
  typeset -gA _OLLAMA_CATALOGUE_CACHE
  if output=$(command curl -q -fsS --connect-timeout 1 --max-time 3 \
    --max-filesize 2097152 \
    "$request[@]" "${base%/}/api/v1/$endpoint" 2>/dev/null); then
    # Validate data before displaying it. Responses are never sourced or evaled.
    parsed=$(print -r -- "$output" |
      LC_ALL=C command awk -F '\t' -v model="$model" '
      NF != 8 { invalid = 1; next }
      $1 !~ /^[A-Za-z0-9_.\/-]+(:[A-Za-z0-9_.-]+)?$/ { invalid = 1; next }
      $2 != "" && ($2 !~ /^[0-9]+$/ || length($2) > 16) { invalid = 1; next }
      $3 != "" && $3 !~ /^[0-9.[:space:]KMGTiB-]+$/ { invalid = 1; next }
      $4 !~ /^[01]$/ { invalid = 1; next }
      $5 != "" && ($5 !~ /^[A-Za-z0-9 -]+$/ || length($5) > 32) {
        invalid = 1; next
      }
      $6 != "" && ($6 !~ /^[0-9]+([.][0-9]+)?[KMGT]?$/ || length($6) > 16) {
        invalid = 1; next
      }
      $7 != "" && ($7 !~ /^[a-z,]+$/ || length($7) > 128) {
        invalid = 1; next
      }
      $8 != "" && $8 !~ /^(yes|no|-)$/ { invalid = 1; next }
      $7 != "" {
        n = split($7, capabilities, ",")
        for (j = 1; j <= n; j++)
          if (capabilities[j] !~ /^(completion|tools|insert|vision|embedding|thinking|image|audio|decision)$/)
            invalid = 1
      }
      model != "" && index($1, model ":") != 1 { invalid = 1; next }
      model == "" && ($1 ~ /:/ || $4 != "0") { invalid = 1; next }
      { records[++count] = $0 }
      END {
        if (invalid) exit 1
        for (i = 1; i <= count; i++) print records[i]
      }')
    [[ -n $parsed ]] && _OLLAMA_CATALOGUE_CACHE[$key]=$parsed
  fi
  # The shared service refreshes expired entries. Retain the last successful
  # response in this shell as an offline fallback, without querying Ollama.com.
  reply=("${(@f)${_OLLAMA_CATALOGUE_CACHE[$key]}}")
  reply=("${(@)reply:#}")
  (( $#reply ))
}

_ollama_remote_models() {
  zstyle -T ":completion:${curcontext}:" remote-models || return 1
  local -a reply models fields names matching expl
  local model entry order label='pullable model' completion_tag=remote-models
  if [[ $PREFIX == *:* ]]; then
    model=${PREFIX%:*}
    label='model tag'
    completion_tag=model-tags
  else
    _ollama_catalogue || return 1
    models=("$reply[@]")
    for entry in "$models[@]"; do
      fields=("${(@ps:\t:)entry}")
      names+=("$fields[1]")
    done
    zstyle -s ":completion:${curcontext}:remote-models" model-sort order
    if [[ $order == (size|reverse-size) ]]; then
      # Ask the service to hydrate only families that match zsh's own rules.
      matching=("$names[@]")
      _description -V remote-models expl "$label"
      compadd "$expl[@]" "$@" -D matching -a names
      if (( $#matching )) && _ollama_catalogue '' "${(j:,:)matching}"; then
        models=("$reply[@]")
      fi
    fi
    # Exact names also expose concrete tags; partial names need only the index.
    if [[ -n $PREFIX && ${names[(Ie)$PREFIX]} -ne 0 ]]; then
      model=$PREFIX
    fi
  fi
  if [[ -n $model ]] && _ollama_catalogue "$model"; then
    models=()
    completion_tag=model-tags
    label='model tag'
    for entry in "$reply[@]"; do
      fields=("${(@ps:\t:)entry}")
      [[ $fields[1] == "$model:latest" ]] && continue
      models+=("$entry")
    done
  fi
  (( $#models )) || return 1
  _ollama_describe_models "$completion_tag" "$label" models "$@"
}

_ollama_models() {
  local ret=1
  _ollama_local_models "$@" && ret=0
  _ollama_remote_models "$@" && ret=0
  return ret
}

_ollama_integrations() {
  local output
  local -a integrations
  output=$(ollama launch --help 2>/dev/null) || return 1
  integrations=("${(@f)$(print -r -- "$output" | command awk '
    /^Supported integrations:/ { reading = 1; next }
    reading && /^$/ { exit }
    reading && $1 ~ /^[a-z][a-z0-9-]*$/ {
      name = $1; $1 = ""; sub(/^[[:space:]]+/, ""); print name ":" $0
      if (match($0, /\(alias(es)?: [a-z0-9, -]+\)/)) {
        aliases = substr($0, RSTART, RLENGTH)
        sub(/^\(alias(es)?: /, "", aliases); sub(/\)$/, "", aliases)
        count = split(aliases, names, /,[[:space:]]*/)
        for (i = 1; i <= count; i++) print names[i] ":alias for " name
      }
    }')}")
  _ollama_describe_values integrations 'integration' integrations "$@"
}

_ollama() {
  local curcontext="$curcontext" state line ret=1
  local -A opt_args
  local -a help=('(- *)'{-h,--help}'[Show help]')
  # Root options are not persistent; stop parsing them at the subcommand.
  _arguments -C -s -S -A '-*' \
    "$help[@]" \
    '(- *)'{-v,--version}'[Show version information]' \
    '--verbose[Show response timings]' \
    '--nowordwrap[Disable word wrapping]' \
    '1: :_ollama_commands' \
    '*:: :->args' && return 0

  [[ $state == args ]] || return ret
  curcontext="${curcontext%:*:*}:ollama-$words[1]:"
  case $words[1] in
    serve|start|list|ls|ps|signin|signout)
      _arguments -s -S "$help[@]" ;;
    create)
      _arguments -s -S "$help[@]" \
        '(-f --file)'{-f,--file}'[Modelfile path]:Modelfile:_files' \
        '(-q --quantize)'{-q,--quantize}'[Safetensors quantization]:level:(int4 int8 nvfp4 mxfp4 mxfp8 fp4 q4 fp8 q8)' \
        '--draft-quantize[Draft model quantization]:level:(int4 int8 nvfp4 mxfp4 mxfp8 fp4 q4 fp8 q8)' \
        '--force[Continue when MLX validation fails]' \
        '1:new model name:' ;;
    show)
      _arguments -s -S "$help[@]" \
        '(--license --modelfile --parameters --system --template)'{--license,--modelfile,--parameters,--system,--template}'[Show this model information]' \
        '(-v --verbose)'{-v,--verbose}'[Show detailed model information]' \
        '1:model:_ollama_local_models' ;;
    run)
      _arguments -s -S "$help[@]" \
        '--format=[Response format]:format:(json)' \
        '--keepalive=[Keep model loaded for this duration]:duration:(0 5m 1h -1)' \
        '--think=-[Thinking mode (bare flag means true)]:mode:(true false high medium low)' \
        '--hidethinking[Hide thinking output]' \
        '--truncate=-[Truncate embedding input]:boolean:(true false)' \
        '--dimensions=[Output embedding dimensions]:dimensions:' \
        '--insecure[Use an insecure registry]' \
        '--nowordwrap[Disable word wrapping]' \
        '--verbose[Show response timings]' \
        '1:model:_ollama_models' \
        '*:prompt:_files' ;;
    stop)
      _arguments -s -S "$help[@]" '1:running model:_ollama_running_models' ;;
    pull)
      _arguments -s -S "$help[@]" '--insecure[Use an insecure registry]' \
        '1:model:_ollama_remote_models' ;;
    push)
      _arguments -s -S "$help[@]" '--insecure[Use an insecure registry]' \
        '1:model:_ollama_local_models' ;;
    cp)
      _arguments -s -S "$help[@]" '1:source model:_ollama_local_models' \
        '2:destination model name:' ;;
    rm)
      _arguments -s -S "$help[@]" '*:model:_ollama_local_models' ;;
    help)
      _arguments -s -S "$help[@]" '1:command:_ollama_commands' ;;
    launch)
      # Everything following -- belongs to the integration, not Ollama.
      local separator=${words[(i)--]}
      (( separator < CURRENT )) && return 1
      _arguments -s -S "$help[@]" \
        '(--restore)--config[Configure without launching]' \
        '(--model --config)--restore[Restore the default integration profile]' \
        '(-y --yes)'{-y,--yes}'[Answer yes to confirmation prompts]' \
        '(--restore)--model=[Model to use]:model:_ollama_models' \
        '1:integration:_ollama_integrations' ;;
  esac
}

_ollama "$@"
