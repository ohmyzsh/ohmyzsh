# _osb — zsh completion for the OpenSandbox CLI (`osb`)
#
# This file is sourced by opensandbox.plugin.zsh (which defines `_osb`
# and its helpers up front; a plain `autoload -U _osb` would make the
# first completion of a multi-function file silently no-op on this
# system's zsh 5.9 — see the plugin's bootstrap comment). It remains on
# $fpath too, so a shell that never sources the plugin still gets a
# working (autoloaded) `_osb` after its second TAB.
#
# Design:
#   - The Click-generated completion is stored in
#     $ZSH_CACHE_DIR/completions/_osb_click (bootstrap:
#     custom/plugins/opensandbox/opensandbox.plugin.zsh). That file defines
#     `_osb_completion`; the file name `_osb_click` is just a cache
#     convention so compinit/autoloading never loads it as a function on
#     its own (it would only autoload if the file were named `_osb`).
#   - _osb delegates to _osb_completion when that function is available
#     (i.e. the cache file was sourced at plugin load), otherwise falls
#     back to a static subcommand list.
#   - At positions where the CLI expects a SANDBOX_ID, `_osb_sandbox_ids`
#     is added on top — Click emits nothing at those positions (verified),
#     so there is no risk of duplicate candidates.
#   - No fork bomb: `_osb_sandbox_ids` calls the CLI at most once per
#     5 s (cached in $ZSH_CACHE_DIR/opensandbox/), and only when the
#     current word position actually expects an ID.
#
# `words`/`CURRENT` semantics (zsh 5.9, verified): at completion time
# `words` holds every typed word INCLUDING the (empty) current word, and
# `CURRENT` is its 1-based index. E.g. after typing "osb terminal " the
# completer sees words=(osb terminal "") and CURRENT=3; after "osb " it
# sees words=(osb "") and CURRENT=2. The case patterns therefore match
# the space-joined words (the empty current word produces a trailing
# space) and gate on CURRENT.

# _osb_sandbox_ids
# Fill `reply` with "<id> (State)" candidates.
# Silent on any error (no sandbox list, server down, JSON parse failure).
_osb_sandbox_ids() {
  # Without $ZSH_CACHE_DIR (sourced outside OMZ) there is nowhere to
  # cache: stay silent instead of touching "/" paths.
  (( $+commands[osb] )) || return 0
  [[ -n "${ZSH_CACHE_DIR:-}" ]] || return 0

  local cache_base="$ZSH_CACHE_DIR/opensandbox"
  local ids_file="$cache_base/ids"
  local stamp_file="$cache_base/ids.stamp"
  local -a lines

  # Freshen the cache if missing or older than 5 s (fork-bomb guard).
  local now age=999
  now=$(date +%s 2>/dev/null)
  if [[ -f "$stamp_file" && -n "$now" ]]; then
    local stamp
    stamp=$(< "$stamp_file")
    (( ${#stamp} )) && age=$(( now - stamp ))
  fi

  if (( age > 5 )) || [[ ! -f "$ids_file" ]]; then
    mkdir -p -- "$cache_base" 2>/dev/null
    local json
    local -a pairs
    json=$(osb sandbox list -o json 2>/dev/null)
    if [[ -n "$json" ]]; then
      if (( $+commands[jq] )); then
        pairs=("${(@f)$( jq -r '.items[] | "\(.id)\t\(.status.state)"' <<< "$json" 2>/dev/null )}")
      elif (( $+commands[python3] )); then
        pairs=("${(@f)$( python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
    for item in data.get("items", []):
        sid = item.get("id", "")
        state = item.get("status", {}).get("state", "")
        if sid:
            print(f"{sid}\t{state}")
except Exception:
    pass
' <<< "$json" 2>/dev/null )}")
      fi
      [[ -n "${pairs[*]-}" ]] || pairs=()
      # Strip a possible trailing empty element from the line split.
      (( ${#pairs} )) && [[ -z "${pairs[-1]}" ]] && unset "pairs[-1]"
      # Arguments come after the format string, so no `--` terminator is
      # needed (printf only parses options before the format).
      (( ${#pairs} )) && printf '%s\n' "${pairs[@]}" >| "$ids_file" 2>/dev/null
    fi
    # Always refresh the stamp (success or failure): this bounds the CLI
    # call to at most one per 5 s even against an unreachable server.
    [[ -n "$now" ]] && print -r -- "$now" >| "$stamp_file" 2>/dev/null
  fi

  [[ -f "$ids_file" ]] || return 0
  lines=("${(@f)$(< "$ids_file")}")
  (( ${#lines} )) || return 0

  local entry state
  for entry in "${lines[@]}"; do
    state="${entry#*$'\t'}"
    entry="${entry%%$'\t'*}"
    [[ -n "$entry" ]] || continue
    [[ "$state" != "$entry" ]] || state=""
    # `completion:description' elements; _describe in _osb splits
    # this and adds ONLY the completion part to the line.
    if [[ -n "$state" ]]; then
      reply+=("$entry:$state")
    else
      reply+=("$entry")
    fi
  done
}

# _osb_completion_available
# True when the generated Click completion function is loaded.
_osb_completion_available() {
  (( $+functions[_osb_completion] ))
}

# _osb
# Entry point: register via `compdef _osb osb` (opensandbox.plugin.zsh).
_osb() {
  # Delegate to the generated Click completion when available: it handles
  # subcommands, options and choices for the current word position.
  _osb_completion_available && _osb_completion

  # Add sandbox IDs at ID-first positions.
  #
  # The patterns require a trailing space in the space-joined words, i.e.
  # the user has started typing a new word. CURRENT is the index of that
  # (still empty) word, so it is one more than the number of subcommand
  # words in the prefix: "osb terminal " -> CURRENT=3,
  # "osb command session run " -> CURRENT=5.
  case "$words[*]" in
    'osb terminal '*)
      (( CURRENT == 3 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb sandbox get '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb sandbox health '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb sandbox kill '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb sandbox pause '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb sandbox resume '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb sandbox renew '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb sandbox endpoint '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb sandbox metrics '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb command run '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb command status '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb command logs '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb command interrupt '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb command session create '*)
      (( CURRENT == 5 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb command session delete '*)
      (( CURRENT == 5 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb command session run '*)
      (( CURRENT == 5 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb file cat '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb file chmod '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb file download '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb file info '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb file mkdir '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb file mv '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb file replace '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb file rm '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb file rmdir '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb file search '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb file upload '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb file write '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb snapshot create '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb egress get '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb egress patch '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb diagnostics context '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb diagnostics events '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb diagnostics logs '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb devops inspect '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
    'osb devops summary '*)
      (( CURRENT == 4 )) && _osb_sandbox_ids && _describe 'Sandbox' reply
      ;;
  esac

  # Static fallback (first call / no cache yet): at least offer the
  # top-level subcommands and --help, so `osb <TAB>` is never empty.
  # Prefix-filtered so `osb ter<TAB>` narrows to `terminal`.
  if (( CURRENT == 2 )) && ! _osb_completion_available; then
    local -a fallback
    fallback=(
      'command:Execute commands in a sandbox.'
      'config:Manage CLI configuration.'
      'credential-vault:Manage sandbox-local Credential Vault state.'
      'devops:Experimental diagnostics for sandbox troubleshooting.'
      'diagnostics:Stable sandbox diagnostics.'
      'egress:Manage runtime egress policy for a sandbox.'
      'file:File operations on a sandbox.'
      'sandbox:Manage sandbox lifecycle.'
      'skills:Manage bundled OpenSandbox skills for AI coding tools.'
      'snapshot:Manage sandbox snapshots.'
      'terminal:Open an interactive terminal into a sandbox.'
      '--help:Show this message and exit.'
    )
    _describe 'Command' fallback
  fi
}
