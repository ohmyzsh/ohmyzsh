#!/usr/bin/env zsh

_omz_git_commit() {
  0=${(%):-%x}
  if [[ "$0" != */git-* ]]; then
    echo >&2 "Expecting command named git-foo. Got '$0'."
    return 1
  fi

  local _type="${0##*/git-}"
  # The subcommand is shortened to avoid Git's built-in revert command.
  if [[ "$_type" == rev ]]; then
    _type=revert
  fi
  local _scope _attention _message _body
  while [ $# -ne 0 ]; do
  case $1 in
    -s | --scope )
      if [ -z "$2" ]; then
        echo >&2 "Missing scope!"
        return 1
      fi
      _scope="$2"
      shift 2
      ;;
    -a | --attention )
      _attention="!"
      shift 1
      ;;
    -b | --body )
      if [ -z "$2" ]; then
        echo >&2 "Missing body!"
        return 1
      fi
      _body="$2"
      shift 2
      ;;
    * )
      _message="${_message} $1"
      shift 1
      ;;
  esac
  done
  git commit -m "${_type}${_scope:+(${_scope})}${_attention}:${_message}" ${_body:+-m} ${_body:+"$_body"}
}
_omz_git_commit "$@"
